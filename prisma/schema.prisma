generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  HOD
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  vmNo      String?  @unique // Real VM NO (e.g. 17433, EMP-CSE-001)
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STUDENT)
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  hodProfile     HodProfile?
}

model UserMode {
  vmno      String   @id
  emailid   String   @unique
  password  String
  usermode  String
  createdAt DateTime @default(now())
}

model StudentProfile {
  userEmail   String   @id
  user        User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  rollNumber  String   @unique
  department  String
  semester    Int      @default(1)
  batch       String   @default("2023-2027")
  createdAt   DateTime @default(now())
}

model FacultyProfile {
  vmNo        String   @id
  user        User     @relation(fields: [vmNo], references: [vmNo], onDelete: Cascade)
  department  String
  designation String   @default("Assistant Professor")
  createdAt   DateTime @default(now())
}

model HodProfile {
  vmNo        String   @id
  user        User     @relation(fields: [vmNo], references: [vmNo], onDelete: Cascade)
  department  String
  designation String   @default("Head of Department")
  createdAt   DateTime @default(now())
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. CSE, ECE, MECH
  name      String   // e.g. Computer Science and Engineering
  hodName   String?  
  createdAt DateTime @default(now())
}

model Subject {
  id             String   @id @default(uuid())
  code           String   @unique // Subject code
  name           String   // e.g. Computer Networks
  credits        Int      @default(3)
  semester       Int      @default(5)
  departmentCode String   @default("CSE")
  createdAt      DateTime @default(now())
}

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("GENERAL") // GENERAL, URGENT, EXAM
  postedBy  String   @default("Admin")
  createdAt DateTime @default(now())
}



model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model TimetableEntry {
  id          String   @id @default(uuid())
  classId     String   // e.g., "IICSEA"
  dayOrder    String   // e.g., "I", "II", "III", "IV", "V"
  period      Int      // 1 to 8
  timeRange   String
  subjectCode String
  subjectName String
  facultyName String
  roomNo      String
  createdAt   DateTime @default(now())
  
  // @@unique([classId, dayOrder, period])
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String   // VM No or Email
  classId     String   // e.g., "IICSEA"
  dateString  String   // e.g., "2026-10-02"
  dayOrder    String
  period      Int
  subjectCode String
  facultyName String
  status      String   @default("PRESENT") // PRESENT, ABSENT, ON_DUTY
  createdAt   DateTime @default(now())

  @@unique([studentId, dateString, period])
}
